{
  "id": "tv-watcher",
  "name": "TV Watcher",
  "description": "Track TV series and movies, get notifications about new episodes",
  "version": "0.1.0",
  "entry": "dist/index.js",
  "skills": ["skills/tv-watcher"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "timezone": { "type": "string", "default": "Europe/Kyiv" },
      "locale": { "type": "string", "default": "auto" },
      "quietHours": {
        "type": "object",
        "properties": { "start": { "type": "string" }, "end": { "type": "string" } },
        "default": { "start": "23:00", "end": "09:00" }
      },
      "dbPath": { "type": ["string", "null"], "default": null }
    }
  },
  "uiHints": {
    "timezone": { "label": "Timezone", "placeholder": "Europe/Kyiv" },
    "locale": { "label": "Locale", "placeholder": "auto" },
    "quietHours": { "label": "Quiet hours" },
    "dbPath": { "label": "Database path" }
  }
}
